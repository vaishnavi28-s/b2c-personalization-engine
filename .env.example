# =====================================================================================
# Copy to .env and fill in. .env is in .gitignore: it never goes to GitHub.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fernet key:                    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================================

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_DB_PASSWORD=
REDIS_PASSWORD=

# --- DAGs come from this repository's main branch ---
GIT_REPO_URL=https://github.com/<your-user>/nbo-recommender.git
# fine-grained GitHub token, read-only "Contents" on this repo (empty if the repo is public)
GIT_READ_TOKEN=

# --- Snowflake (user NBO_AIRFLOW_SVC, key pair: snowflake/setup/service_users.sql) ---
# account identifier, e.g. myorg-myaccount ; the private key file goes to secrets/snowflake_airflow_key.p8
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_KEY_PASSPHRASE=

# --- Email (sending the newsletter + alert emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# app password of the mail account (not your normal password)
SMTP_PASSWORD=
NBO_EMAIL_FROM=
ALERT_EMAIL=

# --- Reporting database + Grafana ---
REPORTING_ADMIN_PASSWORD=
REPORTING_WRITER_PASSWORD=
REPORTING_READER_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=