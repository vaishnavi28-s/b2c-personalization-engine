    {
      "id": 13,
      "type": "timeseries",
      "title": "Pooled lift as sends add up (any purchase)",
      "description": "Each point pools every send evaluated up to that date. The range narrows as customers add up; a real lift smaller than the 'smallest detectable lift' line would not show.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT l.run_date::timestamp AS time, l.value AS lift, l.ci_low AS \"95% low\", l.ci_high AS \"95% high\",\n               m.value AS \"smallest detectable lift\"\n        FROM reporting.eval_results l JOIN reporting.eval_results m ON m.run_date = l.run_date AND m.group_by = 'holdout_pooled'\n          AND m.group_key = 'min_detectable_lift' AND m.metric = l.metric\n        WHERE l.group_by = 'holdout_pooled' AND l.group_key = 'email_minus_holdout' AND l.metric = 'any_buy_rate'\n          AND $__timeFilter(l.run_date) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "text",
                "value": 0
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
