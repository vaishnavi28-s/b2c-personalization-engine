    {
      "id": 14,
      "type": "table",
      "title": "Pooled comparison (latest)",
      "description": "All sends evaluated so far, each customer counted once. In the replay the verdict should be 'no clear difference' (an A/A check of the holdout split).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT l.metric, round(l.value::numeric, 5) AS email_minus_holdout, round(l.ci_low::numeric, 5) AS low,\n               round(l.ci_high::numeric, 5) AS high, round(h.value::numeric, 5) AS holdout_level,\n               round(m.value::numeric, 5) AS smallest_detectable, l.n AS customers,\n               CASE WHEN l.ci_low > 0 THEN 'emails help' WHEN l.ci_high < 0 THEN 'emails hurt'\n                    ELSE 'no clear difference' END AS verdict\n        FROM reporting.eval_results l\n        JOIN reporting.eval_results h ON h.run_date = l.run_date AND h.group_by = l.group_by AND h.metric = l.metric\n          AND h.group_key = 'holdout_level'\n        JOIN reporting.eval_results m ON m.run_date = l.run_date AND m.group_by = l.group_by AND m.metric = l.metric\n          AND m.group_key = 'min_detectable_lift'\n        WHERE l.group_by = 'holdout_pooled' AND l.group_key = 'email_minus_holdout'\n          AND l.run_date = (SELECT max(run_date) FROM reporting.eval_results WHERE group_by = 'holdout_pooled'\n                            AND $__timeFilter(run_date))\n        ORDER BY l.metric"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    }
