    {
      "id": 12,
      "type": "table",
      "title": "Holdout comparison per send",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT run_date, metric, round(value::numeric, 5) AS email_minus_holdout,\n               round(ci_low::numeric, 5) AS low, round(ci_high::numeric, 5) AS high, n AS customers,\n               CASE WHEN ci_low > 0 THEN 'emails help' WHEN ci_high < 0 THEN 'emails hurt' ELSE 'no clear difference'\n               END AS verdict\n        FROM reporting.eval_results WHERE group_by = 'holdout' AND group_key = 'email_minus_holdout' AND $__timeFilter(run_date)\n        ORDER BY run_date DESC, metric"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
